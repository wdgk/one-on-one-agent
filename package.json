{
  "name": "one-on-one-agent",
  "version": "0.1.0",
  "description": "1on1 agenda generation agent using Claude and Backlog MCP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agenda": "./dist/cli.js",
    "ambient": "./dist/ambient/cli/ambient-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "agenda": "node dist/cli.js",
    "agenda:batch": "node dist/batch-cli.js",
    "ambient": "node dist/ambient/cli/ambient-cli.js"
  },
  "keywords": [
    "1on1",
    "agenda",
    "backlog",
    "claude",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.958.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@slack/web-api": "^7.12.0",
    "better-sqlite3": "^11.0.0",
    "date-fns": "^3.0.0",
    "dotenv": "^17.2.3",
    "googleapis": "^169.0.0",
    "js-yaml": "^4.1.1",
    "p-limit": "^5.0.0",
    "prompts": "^2.4.2",
    "uuid": "^9.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
